# -----------------------------------------------------------------------------
# PortfolioPilot AI - Spring Boot backend configuration
# Copy to `.env` (git-ignored) or export these in your shell / secret manager.
# Spring Boot does not read .env files natively - see README "Run instructions".
# -----------------------------------------------------------------------------

# --- MongoDB -----------------------------------------------------------------
# Identical variables to the /mongodb tooling, so one secret serves both.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=portfoliopilot

# MongoDB Atlas (URL-encode the password):
# MONGODB_URI=mongodb+srv://<user>:<pw>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- JWT ---------------------------------------------------------------------
# REQUIRED in any non-local environment. Minimum 32 bytes for HS256.
# Generate:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_real_secret_at_least_32_bytes_long

# Access token lifetime in ms (15 min). Keep short - it cannot be revoked.
JWT_EXPIRATION=900000

# Refresh token lifetime in ms (30 days). Revocable via the refreshTokens collection.
JWT_REFRESH_EXPIRATION=2592000000

# --- CORS --------------------------------------------------------------------
# Origin(s) the browser frontend is served from. Comma-separated.
#
# IMPORTANT: setting this REPLACES the built-in development defaults
# (5173, 3000, 5500, 8000). If you serve on a different port, list it here.
#
# The loopback twin is added automatically: configuring http://localhost:5500
# also allows http://127.0.0.1:5500, because a browser treats those as
# different origins but a developer does not.
#
# The frontend must be served over http:// - a file:// page sends
# "Origin: null" and every CORS request fails.
FRONTEND_URL=http://localhost:5500

# --- Server ------------------------------------------------------------------
SERVER_PORT=8080

# --- Match engine tuning (optional) ------------------------------------------
# Must sum to 1.0 - validated at startup.
MATCH_SKILLS_WEIGHT=0.45
MATCH_PROJECTS_WEIGHT=0.30
MATCH_REQUIREMENTS_WEIGHT=0.25
