# -----------------------------------------------------------------------------
# PortfolioPilot AI - MongoDB configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# -----------------------------------------------------------------------------

# Local MongoDB (development)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=portfoliopilot

# MongoDB Atlas (staging / production) - example shape only, DO NOT commit real values.
# Credentials must be URL-encoded. Prefer injecting this via your secret manager
# (Atlas App Services, AWS Secrets Manager, Vault, Docker secrets, k8s Secret...).
# MONGODB_URI=mongodb+srv://<db_user>:<url_encoded_password>@<cluster>.<hash>.mongodb.net/?retryWrites=true&w=majority&appName=portfoliopilot
# MONGODB_DB=portfoliopilot

# Seed behaviour ---------------------------------------------------------------
# Password assigned to every demo account created by `npm run seed`.
# Demo-only value. Change it, and never reuse it outside local development.
SEED_PASSWORD=DemoPass123!

# bcrypt cost factor for seeded password hashes.
# Keep this identical to the strength configured in Spring Security's
# BCryptPasswordEncoder so seeded users can log in against the real backend.
SEED_BCRYPT_ROUNDS=10

# Set to "true" to allow destructive scripts (npm run reset) to execute.
ALLOW_DESTRUCTIVE=false
