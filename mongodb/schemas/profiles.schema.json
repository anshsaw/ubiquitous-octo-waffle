{
  "collection": "profiles",
  "description": "The user's ONE canonical CV dataset. Skills, education, experience and certificates are EMBEDDED because they are small, bounded, owned by exactly one profile, and are always read together on /profile, /analyzer and /builder. One document read serves the whole page.",
  "validationLevel": "strict",
  "validationAction": "error",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "profiles",
      "required": ["userId", "fullName", "skills", "skillIndex", "education", "experience", "certificates", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "_id": { "bsonType": "objectId" },
        "_class": { "bsonType": "string" },

        "userId": {
          "bsonType": "objectId",
          "description": "REFERENCE -> users._id. 1:1. Unique index enforces exactly one profile per user."
        },

        "avatarUrl": {
          "bsonType": ["string", "null"],
          "maxLength": 2048,
          "description": "URL to object storage (S3/Cloudinary). Binary is NEVER stored in MongoDB: it would bloat every profile read."
        },
        "fullName": { "bsonType": "string", "minLength": 1, "maxLength": 120 },
        "professionalTitle": { "bsonType": ["string", "null"], "maxLength": 120 },
        "bio": { "bsonType": ["string", "null"], "maxLength": 2000 },
        "location": { "bsonType": ["string", "null"], "maxLength": 160 },

        "contact": {
          "bsonType": "object",
          "additionalProperties": false,
          "description": "EMBEDDED single-cardinality value object. Never queried independently.",
          "properties": {
            "phone": { "bsonType": ["string", "null"], "maxLength": 32 },
            "publicEmail": { "bsonType": ["string", "null"], "maxLength": 254 },
            "website": { "bsonType": ["string", "null"], "maxLength": 2048 },
            "github": { "bsonType": ["string", "null"], "maxLength": 2048 },
            "linkedin": { "bsonType": ["string", "null"], "maxLength": 2048 },
            "twitter": { "bsonType": ["string", "null"], "maxLength": 2048 }
          }
        },

        "skills": {
          "bsonType": "array",
          "maxItems": 200,
          "description": "EMBEDDED. Bounded list, meaningless outside its profile, always co-read.",
          "items": {
            "bsonType": "object",
            "required": ["name", "normalizedName", "proficiency"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Exactly what the user typed. Display value."
              },
              "normalizedName": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9+#][a-z0-9+# ]*$",
                "description": "Canonical key from lib/normalize.js + skillDictionary. ALL matching and analytics use this field."
              },
              "proficiency": { "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED", "EXPERT"] },
              "yearsOfExperience": { "bsonType": ["double", "int", "null"], "minimum": 0, "maximum": 60 },
              "category": {
                "enum": ["FRONTEND", "BACKEND", "DATABASE", "DEVOPS", "CLOUD", "MOBILE", "TESTING", "DATA_AI", "TOOLS", "LANGUAGE", "SOFT_SKILL", "OTHER", null],
                "description": "Denormalised from skillDictionary.category so the UI can group skills without a second query."
              }
            }
          }
        },

        "skillIndex": {
          "bsonType": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "description": "DERIVED from skills[].normalizedName. Two jobs: (1) `uniqueItems: true` enforces 'no duplicate skill per profile' at the DB level - JSON Schema cannot express uniqueness on one field inside an array of objects; (2) a single multikey index answers 'who has skill X'. MUST be rebuilt on every skills mutation.",
          "items": { "bsonType": "string", "minLength": 1, "maxLength": 60 }
        },

        "education": {
          "bsonType": "array",
          "maxItems": 30,
          "description": "EMBEDDED. Small, bounded, never shared between users.",
          "items": {
            "bsonType": "object",
            "required": ["_id", "degree", "institution", "startYear"],
            "additionalProperties": false,
            "properties": {
              "_id": {
                "bsonType": "objectId",
                "description": "Stable element id so the UI can PATCH/DELETE one entry via the positional `$` operator."
              },
              "degree": { "bsonType": "string", "minLength": 1, "maxLength": 160 },
              "institution": { "bsonType": "string", "minLength": 1, "maxLength": 160 },
              "fieldOfStudy": { "bsonType": ["string", "null"], "maxLength": 160 },
              "startYear": { "bsonType": "int", "minimum": 1950, "maximum": 2100 },
              "endYear": {
                "bsonType": ["int", "null"],
                "minimum": 1950,
                "maximum": 2100,
                "description": "null = ongoing. Backend must assert endYear >= startYear; JSON Schema cannot compare two sibling fields."
              },
              "grade": { "bsonType": ["string", "null"], "maxLength": 40 },
              "description": { "bsonType": ["string", "null"], "maxLength": 1000 }
            }
          }
        },

        "experience": {
          "bsonType": "array",
          "maxItems": 40,
          "description": "EMBEDDED. Optional - a student profile may legitimately hold an empty array. Never fabricate entries.",
          "items": {
            "bsonType": "object",
            "required": ["_id", "company", "role", "employmentType", "startDate"],
            "additionalProperties": false,
            "properties": {
              "_id": { "bsonType": "objectId" },
              "company": { "bsonType": "string", "minLength": 1, "maxLength": 160 },
              "role": { "bsonType": "string", "minLength": 1, "maxLength": 160 },
              "location": { "bsonType": ["string", "null"], "maxLength": 160 },
              "employmentType": { "enum": ["INTERNSHIP", "FULL_TIME", "PART_TIME", "FREELANCE", "PROJECT"] },
              "startDate": { "bsonType": "date" },
              "endDate": { "bsonType": ["date", "null"], "description": "null = currently working here." },
              "description": { "bsonType": ["string", "null"], "maxLength": 2000 },
              "responsibilities": {
                "bsonType": "array",
                "maxItems": 20,
                "items": { "bsonType": "string", "minLength": 1, "maxLength": 400 }
              },
              "technologies": {
                "bsonType": "array",
                "maxItems": 40,
                "items": { "bsonType": "string", "minLength": 1, "maxLength": 60 }
              },
              "technologiesNormalized": {
                "bsonType": "array",
                "maxItems": 40,
                "uniqueItems": true,
                "description": "DERIVED. Lets experience technologies feed the same match scoring as profile skills.",
                "items": { "bsonType": "string", "minLength": 1, "maxLength": 60 }
              }
            }
          }
        },

        "certificates": {
          "bsonType": "array",
          "maxItems": 50,
          "description": "EMBEDDED. Tiny leaf records with no independent lifecycle.",
          "items": {
            "bsonType": "object",
            "required": ["_id", "name", "issuingOrganization"],
            "additionalProperties": false,
            "properties": {
              "_id": { "bsonType": "objectId" },
              "name": { "bsonType": "string", "minLength": 1, "maxLength": 200 },
              "issuingOrganization": { "bsonType": "string", "minLength": 1, "maxLength": 160 },
              "issueDate": { "bsonType": ["date", "null"] },
              "expiryDate": { "bsonType": ["date", "null"] },
              "credentialId": { "bsonType": ["string", "null"], "maxLength": 120 },
              "credentialUrl": { "bsonType": ["string", "null"], "maxLength": 2048 }
            }
          }
        },

        "profileHealth": {
          "bsonType": ["int", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "Cached completeness score shown on /dashboard. Recomputed by the backend on every profile write so the dashboard needs no aggregation."
        },

        "createdAt": { "bsonType": "date" },
        "updatedAt": { "bsonType": "date" }
      }
    }
  }
}
